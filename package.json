{
  "name": "neobank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:claim": "node scripts/verify-strk20-claim.mjs",
    "card:status": "node --env-file=.env scripts/card-account.mjs status",
    "card:register": "node --env-file=.env scripts/card-account.mjs register",
    "card:deposit": "node --env-file=.env scripts/card-account.mjs deposit",
    "card:balance": "node --env-file=.env scripts/card-account.mjs balance",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@avnu/avnu-sdk": "^4.2.0",
    "@starknet-io/get-starknet-discovery": "6.0.4",
    "@starknet-io/get-starknet-wallet-standard": "6.0.4",
    "@starkware-libs/starknet-privacy-sdk": "file:vendor/starkware-libs-starknet-privacy-sdk-0.14.3-rc.5.tgz",
    "bech32": "^2.0.0",
    "ethers": "^6.17.0",
    "next": "^16.0.8",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "starknet": "10.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@starknet-io/types-js": "0.10.3"
  }
}
