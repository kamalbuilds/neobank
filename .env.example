# Full Starknet RPC URLs. Keep the NEXT_PUBLIC_ prefix: this is a client side
# dapp and Next.js only inlines NEXT_PUBLIC_* into the browser bundle, so a bare
# MAINNET_RPC / TESTNET_RPC is invisible at runtime.
# Empty falls back to the Alchemy key below, then to a public endpoint.
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_TESTNET_RPC=

# Optional Alchemy key suffix only (not a full URL). Used when no full RPC URL
# is set above.
NEXT_PUBLIC_PROVIDER_URL=

# Server-side only. Never prefix with NEXT_PUBLIC_.
# From https://portal.avnu.fi . Leave empty to keep the Swap tab honest-degraded.
AVNU_PAYMASTER_API_KEY=

# Hosted STRK20 card account. Server-only.
CARD_RUNTIME_ACCOUNT_ADDRESS=
CARD_RUNTIME_PRIVATE_KEY=
CARD_RUNTIME_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
CARD_RUNTIME_PROVING_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
CARD_RUNTIME_INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io
CARD_RUNTIME_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
CARD_SETTLEMENT_CONTRACT=
CARD_SETTLEMENT_DEPLOY_BLOCK=
CARD_SETTLEMENT_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
CARD_SETTLEMENT_UNITS_PER_USD=1000000000000000000
CARD_BOOTSTRAP_DEPOSIT_UNITS=4000000000000000000
CARD_WEBHOOK_SECRET=
CARD_PROGRAM_CONTRACT=
CARD_PROGRAMMABLE_SPEND=
CARD_SETTLEMENT_RECIPIENT=
CARD_EARN_VAULT=
CARD_EARN_ADAPTER=
CARD_LEND_UNITS=1000000000000000000
CARD_LEND_CATEGORIES=restaurants,eating_places_restaurants
CARD_MAX_PER_TX_USDC=500
# Stripe issuing sends ISO 3166-1 alpha-2 country codes; Lithic ASA sends
# alpha-3. List every code you accept from every enrolled issuer.
CARD_ALLOWED_COUNTRIES=US,GB,IN,USA,GBR,IND
CARD_BLOCKED_MERCHANT_CATEGORIES=gambling,betting,crypto_cash_advance
# Set to 1 to enable the /card demo authorization button. Off unless explicitly enabled.
CARD_DEMO_AUTHORIZE=
# Official Sepolia ShadowAccountAnonymizer. Hosted card spend identities derive from it.
CARD_SHADOW_ANONYMIZER=0x010a2285310c107c731d997afc147afb7495daff6397c2d242133d9fe8d9b147
# HMAC secret for the single-use demo tokens gating /api/card/shadow-spend and
# /api/card/jit (minted by /api/card/demo-token). Falls back to
# CARD_WEBHOOK_SECRET when unset, so this is optional but recommended to keep
# the two secrets independent. Never commit a value.
DEMO_TOKEN_SECRET=

# ── Lithic card issuing sandbox (self-serve, no approval needed) ──
# https://app.lithic.com/signup . Sandbox API key from the program dashboard.
LITHIC_API_KEY=
LITHIC_ENV=sandbox
# Auth Stream Access HMAC secret: GET https://sandbox.lithic.com/v1/auth_stream/secret
# (creates one on first call). Verifies the Standard Webhooks headers
# (webhook-id, webhook-timestamp, webhook-signature) on every ASA request to
# /api/card/lithic, Lithic's real-time synchronous authorization decisioning
# webhook (the analog of Stripe's issuing_authorization.request).
LITHIC_ASA_SECRET=

# ── Inbound funding (Base Sepolia -> Starknet Sepolia over Circle CCTP V2) ──
# Optional EVM key funded with Base Sepolia ETH + USDC. When set, the fund page
# can execute the Base-side depositForBurn itself; when absent, users burn from
# their own Base wallet and the burn API fails closed with 503.
INBOUND_EVM_PRIVATE_KEY=
# Optional Base Sepolia RPC override. Defaults to https://sepolia.base.org.
BASE_SEPOLIA_RPC_URL=
