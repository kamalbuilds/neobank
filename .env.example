# Full Starknet RPC URLs. Keep the NEXT_PUBLIC_ prefix: this is a client side
# dapp and Next.js only inlines NEXT_PUBLIC_* into the browser bundle, so a bare
# MAINNET_RPC / TESTNET_RPC is invisible at runtime.
# Empty falls back to the Alchemy key below, then to a public endpoint.
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_TESTNET_RPC=

# Optional Alchemy key suffix only (not a full URL). Used when no full RPC URL
# is set above.
NEXT_PUBLIC_PROVIDER_URL=

# Server-side only. Never prefix with NEXT_PUBLIC_.
# From https://portal.avnu.fi . Leave empty to keep the Swap tab honest-degraded.
AVNU_PAYMASTER_API_KEY=
